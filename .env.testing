# Test-suite environment.
#
# Laravel loads .env.testing INSTEAD of .env when APP_ENV=testing, which keeps the
# suite runnable regardless of what a developer has in their local .env. Contains no
# secrets: the database is the in-memory SQLite configured in phpunit.xml, and every
# outbound integration is pointed at a null/array driver so tests cannot reach a real
# service.
APP_NAME="Masjid Management System"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# The refusing null SMS adapter. No test may reach a carrier; `none` (not
# `null`, which env() would turn into an unset value) guarantees it even if the
# ambient environment carries provider credentials.
SMS_DRIVER=none
