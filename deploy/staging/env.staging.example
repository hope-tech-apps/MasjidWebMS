# deploy/staging/env.staging.example — the STAGING OVERRIDE SET
#
# This file is NOT a complete .env. It is the list of keys whose value must
# DIFFER on staging, and it is consumed that way: deploy/staging/provision.sh
# copies every key out of the box's existing (prod-derived) .env and then
# overrides exactly the keys below. Anything not named here — APP_KEY, the
# locale/timezone block, BCRYPT_ROUNDS, the FLYER_CUTOUT_* paths — is inherited
# on purpose, because staging is meant to be production-shaped.
#
# Every key carries the reason it is here. A key with no reason does not belong
# in this file; delete it and let it be inherited.
#
# Values marked <GENERATED> are filled in by provision.sh at run time.
# Values marked <PASTE> must be typed in by a human — see RUNBOOK.md step 4.

# ---------------------------------------------------------------------------
# Identity of the environment
# ---------------------------------------------------------------------------

# Everything staging-shaped keys off this one value: the STAGING ribbon, the
# X-Robots-Tag noindex header, and the staging:scrub command's first guard all
# read it. It is also the reason bin/deploy will accept --ref on this box.
APP_ENV=staging

# APP_DEBUG stays FALSE even though this is not production. WHY: a debug stack
# trace prints the contents of the environment, and this box holds Stripe test
# keys and a database password. Staging is internet-reachable; treat its error
# pages as public. Read the log instead — LOG_LEVEL below is what makes that work.
APP_DEBUG=false

# The single most load-bearing value on the box. config('app.url') builds Stripe
# success/cancel URLs, Connect return URLs, emailed password-reset links, the
# family sign-in link, the CSP origin for the proxied /jummah-lunch and /portal
# paths, and the canary's base URL. Left at the production value, a staging
# checkout mails people links into production and sends Stripe back to prod.
APP_URL=https://masjid-staging.hopetechapps.com

# Added by T-040 (W1) to replace the old `APP_ENV === 'production'` gate on
# URL::forceScheme('https'). Without it every generated URL on a non-production
# box is http:// — including the ones above — while Cloudflare terminates TLS in
# front of us and the CSP's upgrade-insecure-requests breaks the page. This is
# the single most likely staging boot-time surprise; this line is the fix.
FORCE_HTTPS=true

# LOG_LEVEL=debug is the deliberate inverse of production's `warning`. Staging is
# where Log::info is supposed to be visible: prod's warning floor is exactly what
# hid a failing feature with no trace (see NOTES.md). Nothing here is a real
# person's data after the scrub, so verbose logging costs nothing.
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — LOCAL MySQL on this droplet, never the managed cluster
# ---------------------------------------------------------------------------
# The clone arrives pointed at the managed production cluster. That is the single
# most dangerous inherited value in the file: DO MySQL users can see every schema
# on the cluster, so one wrong line and staging is writing to production's data.
# provision.sh installs mysql-server locally and rewrites these four keys; a
# 127.0.0.1 host also means a firewall mistake cannot expose it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masjids_staging
DB_USERNAME=manara_staging
DB_PASSWORD=<GENERATED>

# The managed cluster requires TLS and prod sets a CA path for it. A local
# socket-adjacent TCP connection does not, and a stale CA path makes the
# connection fail with an error that reads like a credentials problem.
MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------------------
# Drivers — match production so staging exercises the same code paths
# ---------------------------------------------------------------------------
# Production runs all three on `database`. Keeping them identical is the point of
# staging: the cache/queue/session tables are real tables with real migrations,
# and a `file` cache (as the stale droplet had) hides the root-owned-cache-file
# class of bug entirely.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# ---------------------------------------------------------------------------
# Host coupling
# ---------------------------------------------------------------------------
# config/cors.php defaults to '*' when this is empty — a staging box that forgets
# it is wide open. It must name every origin that will call the staging API.
CORS_ALLOWED_ORIGINS=https://masjid-staging.hopetechapps.com,https://manara-staging.hopetechapps.com

# config/portal.php parses host=masjidId pairs; the Blade emits
# window.__PORTAL_MASJID__ from it. Inheriting prod's
# `portal.alrazischool.org=14` would serve Al-Razi's real portal from staging on
# a hostname the school does not control. Map the STAGING hostname instead.
PORTAL_HOSTS=portal-staging.hopetechapps.com=14

# A production SESSION_DOMAIN of .hopetechapps.com would let a staging cookie be
# sent to production. Pin it to the staging host, or leave it empty so the cookie
# is host-only (which is what an empty value means).
SESSION_DOMAIN=

# Derived from APP_URL by Sanctum, but stated explicitly so a reader of this file
# does not have to know that. These are the hosts allowed to hold a stateful session.
SANCTUM_STATEFUL_DOMAINS=masjid-staging.hopetechapps.com,manara-staging.hopetechapps.com

# ---------------------------------------------------------------------------
# EGRESS — the whole reason staging is safe. Everything below is blank or sunk.
# ---------------------------------------------------------------------------

# `log` writes the rendered message into storage/logs instead of handing it to
# Resend. This is how the RUNBOOK's "no email left the box" check is possible:
# you can read what WOULD have been sent. `array` would discard it; `log` is
# strictly more useful and equally inert.
MAIL_MAILER=log

# Blank, not merely unused. The production RESEND_KEY was exposed on 2026-08-26
# and is still to be rotated; copying it onto a second box multiplies that.
RESEND_KEY=

# Push. Blank means the OneSignal service is a no-op (W1 made it so instead of
# throwing on construction, which used to make prayers:send-due fail every
# minute). The real belt is the scrub NULLing mobile_app_users.onesignal_
# subscription_id — do both, because a live credential plus a live device id is
# a push to a real person's phone from a test box.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_USER_AUTH_KEY=
ONESIGNAL_REST_API_URL=

# The assistant. A blank key fails at call time with a 401, which is the correct
# staging behaviour; the escalation address is the dangerous one — its default in
# config/services.php is two real inboxes, so an unset value mails real people.
ANTHROPIC_API_KEY=
ASSISTANT_ESCALATION_EMAIL=staging@staging.invalid

# `none` is a hard off. SmsProviderFactory would otherwise fall through to
# "twilio if configured", and a NullSmsProvider throws at send time so the
# delivery is recorded FAILED rather than silently succeeding. Nothing here can
# text a real number; the scrub also removes every masjid_sms_senders row.
SMS_DRIVER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A set GITHUB_DISPATCH_TOKEN fires a real repository_dispatch at
# hope-tech-apps/burlington-masjid-{iOS,Android} — i.e. a staging click starts a
# real CI run and can push a build to TestFlight. Blank.
GITHUB_DISPATCH_TOKEN=

# Realtime. Production's Pusher path was removed in 2026-08; these keys are
# vestigial on prod and must not travel to a second box regardless.
BROADCAST_CONNECTION=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# ---------------------------------------------------------------------------
# Stripe — TEST MODE ONLY. These are the two things a human must paste.
# ---------------------------------------------------------------------------
# !!! Blank here ON PURPOSE. provision.sh will not invent them and must not
# !!! inherit prod's, which are LIVE keys (sk_live_, 107 chars) attached to a
# !!! real connected account taking real donations.
# !!!
# !!! Paste TEST-mode keys by hand (RUNBOOK step 4) and create a TEST-mode
# !!! webhook pointing at https://masjid-staging.hopetechapps.com/api/stripe/webhook.
# !!! Until then, any checkout on staging throws from the SDK — which is a clean,
# !!! visible failure and much safer than a working live charge.
STRIPE_KEY=<PASTE sk/pk test keys — see RUNBOOK step 4>
STRIPE_SECRET=<PASTE>
STRIPE_WEBHOOK_SECRET=<PASTE>
STRIPE_CONNECT_WEBHOOK_SECRET=<PASTE>

# ---------------------------------------------------------------------------
# Scheduled work that reaches outside the box
# ---------------------------------------------------------------------------
# tenancy:canary probes CANARY_BASE_URL, falling back to APP_URL. Inherited
# blank on a box whose APP_URL was still prod's, the staging canary would hammer
# production's /api/mobile rate-limit bucket hourly. State it.
CANARY_BASE_URL=https://masjid-staging.hopetechapps.com

# backup:run WRITES AND PRUNES sets under this path. Both boxes mounting the same
# default would let a staging run prune production's backup sets. A staging-only
# path makes that impossible even if the schedule is left enabled.
BACKUP_DESTINATION=/var/backups/manara-staging

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# MUST STAY EMPTY. vite bakes this into the bundle; a baked host makes the SPA
# call that host from every other host it is served on. scripts/ship.sh asserts
# it is unset before building and greps the shipped chunk afterwards.
VITE_APP_URL=

# Cosmetic, but it is what a developer sees in the browser tab.
APP_NAME="Manara (STAGING)"
VITE_APP_NAME="Manara (STAGING)"
