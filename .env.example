APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="masjids management system"
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Security: keep these as `true` in production. Override only for local plain-HTTP dev.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Security: comma-separated list of origins allowed to call the API via CORS.
# Use the EXACT origin including scheme. Wildcard (*) means anyone — only use
# in dev and only if your endpoints don't accept credentials.
CORS_ALLOWED_ORIGINS=https://your-admin.example.com,https://your-site.example.com

# Security: Sanctum personal access token expiration in minutes (8 hours default).
SANCTUM_EXPIRATION=480

# Security: Pusher webhook signature secret. Populate from Pusher dashboard.
PUSHER_WEBHOOK_SECRET=

# Stripe (CRM donations — Connect Standard accounts + direct charges).
# Leave the three secrets EMPTY here; populate real test-mode values in .env.
# STRIPE_KEY/STRIPE_SECRET are the test-mode API keys (pk_test_/sk_test_);
# STRIPE_WEBHOOK_SECRET (whsec_...) is the signing secret that gates the
# unauthenticated /api/stripe/webhook route; STRIPE_CONNECT_WEBHOOK_SECRET is
# the SEPARATE secret of the Stripe *Connect* endpoint, which delivers every
# event raised on a connected account (all registration charges are direct
# charges on the org's account). Both are verified fail-closed; an unset one
# simply verifies nothing. Optional tunables below have working defaults in
# config/services.php and normally stay unset.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_FEE_PERCENTAGE=0.029      # Stripe's fee %, used for donor-covers-fees gross-up
# STRIPE_FEE_FIXED=30              # Stripe's fixed fee in minor units (cents)
# STRIPE_PLATFORM_FEE_PERCENTAGE=0 # platform application_fee share of the donation
# STRIPE_CURRENCY=usd              # default settlement currency
# STRIPE_REGISTRATION_CHECKOUT_WINDOW_MINUTES=30  # how long a paid pending holds its seat
# STRIPE_REGISTRATION_REAPER_GRACE_MINUTES=15     # extra margin before registrations:reap-expired sweeps that hold

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ONESIGNAL_REST_API_URL=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Account-scoped key (called "Organization REST API Key" on newer accounts,
# "User Auth Key" on older ones). Required for the splash announcement IAM
# sync AND for per-masjid OneSignal app auto-provisioning (creating apps).
# The app-scoped REST key above returns "Please include … User Auth Key" when
# used against /apps/{id}/... Find at:
# https://dashboard.onesignal.com → name top right → Account → Keys & IDs.
ONESIGNAL_USER_AUTH_KEY=

# --- Per-masjid OneSignal app auto-provisioning (org-level M2M creds) ---
# Used ONLY by App\Services\OneSignalProvisioningService to mint a per-masjid
# OneSignal app so onboarding needs no manual dashboard step. All optional:
# when unset, provisioning returns a clear error and the shared app keeps
# working. See config/services.php ('onesignal' block).
#
# OneSignal Apps API endpoint (leave default unless OneSignal changes it).
ONESIGNAL_APPS_API_URL=https://api.onesignal.com/apps
# Team APNs auth key used to seed iOS push on newly created apps. ONESIGNAL_APNS_P8
# is the RAW contents of the AuthKey_XXXX.p8 file (BEGIN/END PRIVATE KEY block).
ONESIGNAL_APNS_P8=
ONESIGNAL_APNS_KEY_ID=
ONESIGNAL_APNS_TEAM_ID=
# APNs environment for created apps: production | sandbox.
ONESIGNAL_APNS_ENV=production
# FCM v1 service-account JSON (raw JSON) to seed Android push on new apps.
ONESIGNAL_FCM_V1_SERVICE_ACCOUNT_JSON=

# --- App-provisioning control plane (GitHub repository_dispatch) ---
# The Super-Admin "Generate apps" action fires a GitHub repository_dispatch to a
# mobile repo whose workflow (self-hosted runner) scaffolds + builds + uploads a
# masjid's app. See config/services.php ('github' block).
#
# Org / fine-grained PAT authorizing POST /repos/{owner/repo}/dispatches on the
# two mobile repos (needs `contents:read` + Dispatch, or classic `repo`). Wire it
# as an ORG SECRET. When unset, a dispatch fails-soft with a clear error (the job
# is marked failed) instead of crashing. NEVER hardcode or echo this.
GITHUB_DISPATCH_TOKEN=
# The full "owner/repo" each platform dispatches to (defaults shown).
GITHUB_IOS_REPO=hope-tech-apps/burlington-masjid-iOS
GITHUB_ANDROID_REPO=hope-tech-apps/burlington-masjid-Android
# Platform-default Apple Developer Team ID for signing managed-tier iOS builds.
# Overridden per-masjid by masjid_app_publishing.development_team (BYO) when set.
APPLE_DEVELOPMENT_TEAM=
# Default reverse-DNS prefix for a derived iOS bundle id when no explicit
# bundle_id override is supplied on the "Generate apps" request.
IOS_BUNDLE_PREFIX=com.hopetechapps

# --- Server-side Google Geocoding (onboarding wizard) ---
# Used by App\Services\Onboarding\GeocodingService so the Super-Admin onboarding
# wizard can turn a typed street address into latitude/longitude (the "Find
# coordinates" button). This is a SERVER-SIDE key (NOT the HTTP-referrer-
# restricted browser key on the public Nuxt site — that one can't be used
# server-side). Enable the "Geocoding API" on the key in Google Cloud.
# Optional: when unset, the geocode endpoint returns a clear "not configured"
# message and the wizard falls back to its manual lat/long inputs. See
# config/services.php ('google' block). NEVER commit a real key.
GOOGLE_MAPS_GEOCODING_KEY=

# --- SMS broadcast channel (Twilio adapter, US A2P 10DLC) ---
# The SMS channel of the unified publish composer. See config/services.php
# ('sms' and 'twilio' blocks) and .claude/rules/broadcasts.md.
#
# Adapter selection. Leave UNSET in production: the factory then uses Twilio if
# the credentials below are present, and otherwise the refusing null adapter, so
# a deployment without SMS behaves exactly as it did before the channel existed.
#   twilio = the real provider   log = local dev, logs and sends nothing
#   none   = always refuse       (the word is `none`, NOT `null` — env() turns
#                                 the string "null" into PHP null)
SMS_DRIVER=
# Country assumed for a bare national number when normalising to E.164. Numbers
# that cannot be resolved with confidence are refused, never guessed.
SMS_DEFAULT_COUNTRY_CODE=1
# Cost/readability ceiling per message (~3 GSM-7 segments). The sender identity
# and the "Reply STOP" line are never truncated to fit it.
SMS_MAX_BODY_LENGTH=480
# Appended by code to EVERY outbound message. Carrier rules require it.
SMS_OPT_OUT_LANGUAGE="Reply STOP to unsubscribe."
#
# Twilio ACCOUNT credentials (machine-to-machine, like the Stripe keys). NEVER
# hardcode or commit real values. The auth token also signs inbound webhooks:
# unset means the STOP/START webhook rejects everything, which is deliberate —
# it fails closed exactly like the Stripe webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE=https://api.twilio.com/2010-04-01
# Optional. Only needed when a proxy rewrites the URL Twilio dialled, which
# would otherwise break signature verification. Set it to the public HTTPS URL
# of POST /api/sms/webhook.
TWILIO_WEBHOOK_URL=
TWILIO_HTTP_TIMEOUT=15
#
# A tenant's OWN sending number, messaging service and A2P 10DLC registration
# state are NOT env vars — they are per-masjid rows in `masjid_sms_senders`.
# There is no shared fallback number on purpose.

#
# ─────────────────────────────────────────────────────────────────────────────
# BACKUPS
# ─────────────────────────────────────────────────────────────────────────────
#
# The destination and retention have defaults that are right for the droplet; see
# config/backup.php. What is listed here is the part an operator has to decide.
#
# THE ONE VARIABLE THAT TURNS ON-CALL ON. `backup:check`, `backup:drill`,
# `media:verify` and `tenancy:canary` all leave one log line per run whose LEVEL
# carries the verdict. The `ops-alerts` channel emails `error` and above to this
# address and is completely inert while it is empty — which is what it is on
# production today, and which is why nobody saw a nightly backup refuse for
# weeks. Set it.
OPS_ALERT_EMAIL=
OPS_ALERT_LEVEL=error
#
# How stale the newest verified set may be before `backup:check` pages. 36 hours
# is one missed nightly run plus slack; 24 would page every time cron is late.
BACKUP_CHECK_MAX_AGE_HOURS=36
#
# THE DEAD MAN'S SWITCH, and the only part of the monitoring that survives this
# host going away. Everything else — the heartbeat file, the log line, the alert
# email — is written BY the machine being watched, so if cron or the droplet
# stops they all go quiet together, and quiet is what a healthy night looks like.
# Point this at a URL that alerts when it is NOT called (healthchecks.io, Better
# Stack, a push-style uptime check). It is pinged only after a CLEAN run, so a
# failing check and a dead check are the same signal to the outside.
BACKUP_CHECK_HEARTBEAT_URL=
#
# ── The off-site copy ────────────────────────────────────────────────────────
#
# OFF by default and off honestly: with these unset, every backup set exists only
# on the same volume as the application it backs up, and `backup:check` says so
# in full on every run.
#
# These are NOT the AWS_* variables above. Those belong to the `s3` disk media
# might live on one day — public images. This bucket holds an entire
# organisation's database including children's records, so it gets its own
# credential, expected to be scoped to this bucket alone: a leak of the web
# tier's config must not become a leak of every backup ever taken.
#
# To turn it on (DigitalOcean Spaces):
#   1. Create a PRIVATE Space in a region OTHER than this droplet's, so a
#      regional outage is not one event. Note what the same provider does and
#      does not buy: it covers a destroyed droplet, a corrupted volume and a
#      wrong `rm`; it does NOT cover a compromised or suspended DigitalOcean
#      account, which reaches droplet, database and Space alike.
#   2. Create a Spaces access key and restrict it to that Space.
#   3. Fill in the six lines below and set BACKUP_OFFSITE_ENABLED=true.
#   4. php artisan backup:ship --dry-run     (nothing leaves the machine)
#   5. php artisan backup:ship --all         (the sets already on disk)
#   6. php artisan backup:check              (should now say off-site: present)
#   7. Set BACKUP_OFFSITE_REQUIRED=true so a regression pages.
#
# Then parse-check the file and reload config carefully — a bad .env plus
# `config:cache` is every request 500, because config:cache CLEARS first.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_REGION=
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_PREFIX=manara
# SSE-S3: the store encrypts at rest with a key IT holds. That stops a stolen
# disk and stops nothing that has the bucket credential. Client-side encryption
# is deliberately not implemented — see config/backup.php for why.
BACKUP_OFFSITE_SSE=AES256
BACKUP_OFFSITE_REQUIRED=false
#
# ── The restore drill ────────────────────────────────────────────────────────
#
# `backup:drill` restores the newest set into a scratch schema on the managed
# database server and drops it again. The backup user needs CREATE and DROP on
# schemas matching this prefix. The LIVE database name must not begin with it —
# the drill refuses to run at all if it does, because then its cleanup could not
# be told apart from dropping production.
BACKUP_DRILL_SCRATCH_PREFIX=manara_drill_

VITE_APP_NAME="${APP_NAME}"
